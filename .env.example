# MELANGEE Environment Configuration Sample
# Copy this file to .env and replace the values with your local configuration

# Server Configuration
PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/melangee?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# JWT Security Configuration
# Must be a 256-bit (64 hex characters) secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initial Admin Seeding Configuration (Created on startup if not already existing)
INITIAL_ADMIN_EMAIL=admin@melangee.com
INITIAL_ADMIN_PASSWORD=Admin@123456
INITIAL_ADMIN_NAME=Melangee Administrator

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

